# Local use: leave APP_ENV=development and the token blank for loopback-only use.
# Docker Compose forces production mode and requires a 32+ character token.
APP_ENV=development
AI_INVESTIGATOR_API_TOKEN=

# Comma-separated exact browser origins; same-origin requests need no CORS entry.
CORS_ALLOWED_ORIGINS=

# Per-client in-memory limit (single process only).
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
PORT=8000
